<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: plain HTTP to a Supabase stack on the development machine, reached from the
  emulator as 10.0.2.2 or through adb reverse as 127.0.0.1. Everything else stays HTTPS-only, and
  release builds have no such file.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
