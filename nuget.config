<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Vendored DotNetLib.Core so the desktop builds standalone on any machine. -->
    <add key="vendored" value="desktop/local-packages" />
    <!-- Optional live feed if the dotnetlib repo is cloned as a sibling. -->
    <add key="dotnetlib-local" value="..\dotnetlib\artifacts\nuget" />
  </packageSources>
</configuration>
