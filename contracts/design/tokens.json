{
  "format": "subtrackr-design-tokens",
  "version": 1,
  "note": "Semantic colors for both apps. neutral and accent are separate groups so an accent change never touches surfaces. Values are #RRGGBB. Text tokens reach WCAG AA (4.5:1) on background and surface in their theme; onAccent does on accent.",
  "neutral": {
    "dark": {
      "background": "#1A1B1E",
      "surface": "#25262B",
      "surfaceAlt": "#2E2F35",
      "border": "#3A3B42",
      "textPrimary": "#F1F3F5",
      "textSecondary": "#9AA0A6",
      "textMuted": "#8E949C",
      "positive": "#3DD68C",
      "negative": "#FF6B6B",
      "warning": "#FFC048"
    },
    "light": {
      "background": "#F4F5F7",
      "surface": "#FFFFFF",
      "surfaceAlt": "#ECEEF1",
      "border": "#D3D7DD",
      "textPrimary": "#1A1B1E",
      "textSecondary": "#555C66",
      "textMuted": "#646B74",
      "positive": "#177A4C",
      "negative": "#C53030",
      "warning": "#975A16"
    }
  },
  "accent": {
    "dark": {
      "accent": "#4C8DFF",
      "accentHover": "#6BA1FF",
      "onAccent": "#0E1726"
    },
    "light": {
      "accent": "#2F6FE0",
      "accentHover": "#1F5CC8",
      "onAccent": "#FFFFFF"
    }
  },
  "brand": {
    "gradientStart": "#4C8DFF",
    "gradientEnd": "#B084FF",
    "mark": "#F5F6FF"
  },
  "chart": {
    "dark": ["#4C8DFF", "#3DD68C", "#FFC048", "#FF6B6B", "#B084FF", "#4CD4E0", "#FF9F6B", "#E86BC7"],
    "light": ["#2F6FE0", "#1E9E62", "#D99A1E", "#D94848", "#8B5CF6", "#0EA5B7", "#E67E3A", "#C94BA6"]
  }
}
