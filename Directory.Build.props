<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Company>Lukáš Krejčí</Company>
    <Authors>Lukáš Krejčí</Authors>
    <Product>SubTrackr</Product>
    <Copyright>Copyright Lukáš Krejčí. PolyForm Noncommercial 1.0.0.</Copyright>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Version.props" />

  <!--
    Only builds made with -p:SubTrackrReleaseBuild=true (installer/build-installer.ps1 and the
    release workflow) carry the plain version. Every other build is "-dev", so a local or test build
    is never mistaken for a shipped release (contracts/SPEC.md section 7).
  -->
  <PropertyGroup>
    <SubTrackrReleaseBuild Condition="'$(SubTrackrReleaseBuild)' == ''">false</SubTrackrReleaseBuild>
    <Version Condition="'$(SubTrackrReleaseBuild)' == 'true'">$(SubTrackrVersion)</Version>
    <Version Condition="'$(SubTrackrReleaseBuild)' != 'true'">$(SubTrackrVersion)-dev</Version>
    <AssemblyVersion>$(SubTrackrVersion).0</AssemblyVersion>
    <FileVersion>$(SubTrackrVersion).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
