<Project Sdk="Microsoft.NET.Sdk">

  <!-- Adapters behind SubTrackr.Core's interfaces: files, HTTP, DPAPI, processes, logging. Windows only. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SubTrackr.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubTrackr.Core\SubTrackr.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DPAPI for the sign-in session file. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

</Project>
