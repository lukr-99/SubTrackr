<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:SubTrackr.Core;assembly=SubTrackr.Core">

    <!--
      Text styles: the app-wide base text and the named text roles pages use.
      Every color is a DynamicResource set at run time by Theming/ThemeApplier from
      contracts/design/tokens.json (SPEC.md section 10), so light, dark, and system switch live.
    -->

    <!-- Base text. No Foreground here: an app-wide implicit TextBlock style also reaches the text
         inside control templates, and would repaint button and list text over the accent. Text
         inherits its color from the window (TextPrimary) or from the control around it. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,14,0,5" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- A worth verdict in its status color; binds to a Verdict property on the data context. -->
    <Style x:Key="VerdictText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Verdict}" Value="{x:Static core:WorthVerdict.Worth}">
                <Setter Property="Foreground" Value="{DynamicResource Positive}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Verdict}" Value="{x:Static core:WorthVerdict.NotWorth}">
                <Setter Property="Foreground" Value="{DynamicResource Negative}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Verdict}" Value="{x:Static core:WorthVerdict.Essential}">
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
