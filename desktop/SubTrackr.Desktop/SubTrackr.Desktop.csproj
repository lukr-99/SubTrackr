<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>SubTrackr</AssemblyName>
    <RootNamespace>SubTrackr.Desktop</RootNamespace>
    <ApplicationIcon>Assets\SubTrackr.ico</ApplicationIcon>
    <Description>Personal subscription tracker</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubTrackr.Core\SubTrackr.Core.csproj" />
    <ProjectReference Include="..\SubTrackr.Infrastructure\SubTrackr.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- The shared color tokens, built in: the app's only source of theme colors (SPEC.md section 10). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\contracts\design\tokens.json"
                      LogicalName="SubTrackr.Contracts.tokens.json"
                      Link="Theming\tokens.json" />
  </ItemGroup>

  <!-- The shared logo geometry and launch animation, built in (SPEC.md section 10). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\contracts\design\logo.json"
                      LogicalName="SubTrackr.Contracts.logo.json"
                      Link="Branding\logo.json" />
  </ItemGroup>

</Project>
