<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SubTrackr</AssemblyName>
    <RootNamespace>SubTrackr.Desktop</RootNamespace>
    <ApplicationIcon>Assets\SubTrackr.ico</ApplicationIcon>
    <Version>0.2.2</Version>
    <FileVersion>0.2.2.0</FileVersion>
    <AssemblyVersion>0.2.2.0</AssemblyVersion>
    <Product>SubTrackr</Product>
    <Company>lukr-99</Company>
    <Authors>lukr-99</Authors>
    <Description>Personal subscription tracker</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubTrackr.Core\SubTrackr.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Shared self-update service (local feed; see ..\..\nuget.config). -->
    <PackageReference Include="DotNetLib.Core" Version="0.1.0" />
  </ItemGroup>

</Project>
