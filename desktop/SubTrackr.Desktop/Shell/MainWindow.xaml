<Window x:Class="SubTrackr.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SubTrackr.Desktop.ViewModels"
        xmlns:views="clr-namespace:SubTrackr.Desktop.Views"
        Title="{Binding WindowTitle}" Height="770" Width="1200" MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== NAV RAIL ==================== -->
        <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <StackPanel>
                <Border Width="34" Height="34" CornerRadius="9" Margin="0,16,0,22" HorizontalAlignment="Center"
                        Background="{DynamicResource Accent}">
                    <TextBlock Text="S" FontWeight="Bold" FontSize="19" Foreground="{DynamicResource OnAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <RadioButton Style="{StaticResource NavButton}" ToolTip="Dashboard"
                             IsChecked="{Binding IsDashboardPage, Mode=OneWay}"
                             Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:AppPage.Dashboard}">
                    <Viewbox Width="22" Height="22">
                        <Path Data="M3,3h8v8H3V3z M13,3h8v5h-8V3z M13,10h8v11h-8V10z M3,13h8v8H3V13z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </Viewbox>
                </RadioButton>

                <RadioButton Style="{StaticResource NavButton}" ToolTip="What-if calculator"
                             IsChecked="{Binding IsWhatIfPage, Mode=OneWay}"
                             Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:AppPage.WhatIf}">
                    <Viewbox Width="22" Height="22">
                        <Path Data="M6,2h12a2,2 0 0 1 2,2v16a2,2 0 0 1 -2,2H6a2,2 0 0 1 -2,-2V4a2,2 0 0 1 2,-2z M7,5h10v3H7V5z M7,11h2v2H7z M11,11h2v2h-2z M15,11h2v2h-2z M7,15h2v2H7z M11,15h2v4h-2z M15,15h2v2h-2z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </Viewbox>
                </RadioButton>

                <RadioButton Style="{StaticResource NavButton}" ToolTip="Settings"
                             IsChecked="{Binding IsSettingsPage, Mode=OneWay}"
                             Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:AppPage.Settings}">
                    <Viewbox Width="22" Height="22">
                        <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </Viewbox>
                </RadioButton>
            </StackPanel>
        </Border>

        <views:DashboardView Grid.Column="1" DataContext="{Binding Dashboard}"
                             Visibility="{Binding DataContext.IsDashboardPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}" />

        <views:WhatIfView Grid.Column="1" DataContext="{Binding WhatIf}"
                          Visibility="{Binding DataContext.IsWhatIfPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}" />

        <views:SettingsView Grid.Column="1" DataContext="{Binding Settings}"
                            Visibility="{Binding DataContext.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}" />
    </Grid>
</Window>
