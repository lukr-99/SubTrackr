<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Generate C# models from the shared contract at build time.
       Do not hand-edit generated files. -->
  <ItemGroup>
    <Protobuf Include="..\..\contracts\proto\subtrackr.proto"
              GrpcServices="None"
              ProtoRoot="..\..\contracts\proto" />
  </ItemGroup>

</Project>
